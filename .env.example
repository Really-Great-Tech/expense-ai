# Aurora MySQL (required - IAM authentication only)
MYSQL_HOST=your-aurora-cluster.cluster-xxxxx.eu-west-1.rds.amazonaws.com
MYSQL_USER=app
MYSQL_DATABASE=expense_ai

# AWS (required for IAM auth)
AWS_REGION=eu-west-1

# ElastiCache Redis (required)
REDIS_HOST=your-elasticache-cluster.xxxxx.eu-west-1.cache.amazonaws.com

# S3 Storage (required)
S3_BUCKET_NAME=expenses-ai-production

# Bedrock Inference Profiles (required)
BEDROCK_NOVA_MICRO_ARN=arn:aws:bedrock:eu-west-1:123456789012:inference-profile/nova-micro-profile-id
BEDROCK_NOVA_PRO_ARN=arn:aws:bedrock:eu-west-1:123456789012:inference-profile/nova-pro-profile-id
BEDROCK_SONNET_4_ARN=arn:aws:bedrock:eu-west-1:123456789012:inference-profile/sonnet-4-profile-id
