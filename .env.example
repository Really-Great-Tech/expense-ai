NODE_ENV=production
PORT=3000

AURORA_MYSQL=true
MYSQL_HOST=your-aurora-cluster.cluster-xxxxx.us-east-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=iam_db_user
MYSQL_DATABASE=expense_ai
MYSQL_SSL=true
MYSQL_IAM_AUTH_ENABLED=true
DB_CONNECTION_LIMIT=50
DB_QUEUE_LIMIT=0

TYPEORM_MIGRATIONS_RUN=false
TYPEORM_LOGGING=

AWS_REGION=us-east-1

REDIS_MODE=managed
REDIS_CLUSTER_ENABLED=false
REDIS_HOST=your-production-cluster.xxxxx.use1.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=your_auth_token_from_secrets_manager
REDIS_DB=0
REDIS_TLS_ENABLED=true

STORAGE_TYPE=s3
S3_BUCKET_NAME=expenses-ai-production
UPLOAD_PATH=/app/uploads

DOCUMENT_READER=textract

BEDROCK_NOVA_MICRO_ARN=arn:aws:bedrock:us-east-1:123456789012:inference-profile/nova-micro-profile-id
BEDROCK_NOVA_PRO_ARN=arn:aws:bedrock:us-east-1:123456789012:inference-profile/nova-pro-profile-id
BEDROCK_SONNET_4_ARN=arn:aws:bedrock:us-east-1:123456789012:inference-profile/sonnet-4-profile-id
BEDROCK_SONNET_4_5_ARN=

WORKER_CONCURRENCY=20
SPLITTER_CONCURRENCY=25
MAX_RETRY_ATTEMPTS=3
JOB_TIMEOUT=300000

THROTTLE_TTL=60
THROTTLE_LIMIT=100

PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----\n"

REQUEST_BODY_LIMIT=1mb
URL_ENCODED_LIMIT=1mb
